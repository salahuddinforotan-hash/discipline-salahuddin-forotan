# Public DNS name pointing to this server; Caddy uses it to issue HTTPS certificates.
DOMAIN=
ACME_EMAIL=

# Generate each value separately with: openssl rand -hex 32
DB_PASSWORD=
SECRET_KEY=

APP_TIMEZONE=Asia/Kabul
ALERT_CHECK_INTERVAL_SECONDS=60

# Optional placeholders for a future official Azizi Bank integration.
# No public API adapter is currently available, so these do not enable live sync.
AZIZI_BANK_API_BASE_URL=
AZIZI_BANK_CLIENT_ID=
AZIZI_BANK_CLIENT_SECRET=
AZIZI_BANK_REDIRECT_URI=

# AI configuration (choose either Ollama or an OpenAI-compatible provider).
AI_PROVIDER=ollama
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=45
